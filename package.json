{
  "name": "scopuly-extension",
  "version": "0.3.2",
  "private": true,
  "description": "Manifest V3 browser extension that connects Stellar dApps to a paired Scopuly signer.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Scopuly/scopuly-browser-extension.git"
  },
  "bugs": {
    "url": "https://github.com/Scopuly/scopuly-browser-extension/issues"
  },
  "homepage": "https://github.com/Scopuly/scopuly-browser-extension#readme",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "playground:dev": "vite --config examples/developer-playground/vite.config.ts --host 0.0.0.0",
    "playground:check": "tsc --noEmit -p examples/developer-playground/tsconfig.json",
    "playground:build": "npm run playground:check && vite build --config examples/developer-playground/vite.config.ts",
    "playground:preview": "vite preview --config examples/developer-playground/vite.config.ts --host 0.0.0.0",
    "build": "npm run build:chromium",
    "build:chromium": "tsc --noEmit && vite build && node scripts/prepare-target.mjs chromium && node scripts/check-extension.mjs --dist",
    "build:firefox": "tsc --noEmit && vite build && node scripts/prepare-target.mjs firefox && node scripts/check-extension.mjs --dist",
    "package:chromium": "npm run build:chromium && node scripts/package-extension.mjs chromium",
    "package:edge": "npm run build:chromium && node scripts/package-extension.mjs edge",
    "package:firefox": "npm run build:firefox && node scripts/package-extension.mjs firefox && node scripts/prepare-target.mjs chromium && node scripts/check-extension.mjs --dist",
    "package:source": "node scripts/package-extension.mjs source",
    "reproduce:firefox": "node scripts/reproduce-firefox.mjs",
    "smoke:chromium": "node scripts/smoke-extension.mjs",
    "smoke:playground": "npm run playground:build && node scripts/smoke-developer-playground.mjs",
    "smoke:chromium:archive": "node scripts/smoke-extension.mjs --archive",
    "smoke:chromium:pairing": "node scripts/smoke-pairing-flow.mjs --archive",
    "smoke:chromium:reviewer-assets": "node scripts/smoke-pairing-flow.mjs --archive --capture-assets",
    "smoke:firefox:archive": "node scripts/smoke-firefox.mjs",
    "check:store-assets": "node scripts/check-store-assets.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "check:opensource": "node scripts/check-open-source.mjs",
    "check:release": "node scripts/check-release.mjs",
    "check": "tsc --noEmit && npm run playground:check && node scripts/check-extension.mjs && npm run check:opensource && npm run check:store-assets"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^16.2.0",
    "lucide": "^1.28.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@scopuly/signer-extension-api": "0.3.2",
    "@types/chrome": "^0.0.268",
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.6",
    "archiver": "^8.0.0",
    "playwright-core": "^1.61.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^4.1.10",
    "web-ext": "^10.6.0"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.5",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.17",
    "postcss": "8.5.25",
    "shell-quote": "1.10.0"
  }
}
